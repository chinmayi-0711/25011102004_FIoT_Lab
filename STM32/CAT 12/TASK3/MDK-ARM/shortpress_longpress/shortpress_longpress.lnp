"shortpress_longpress\stm32f4xx_hal_flash_ex.o"
"shortpress_longpress\stm32f4xx_hal_flash_ramfunc.o"
"shortpress_longpress\stm32f4xx_hal_gpio.o"
"shortpress_longpress\stm32f4xx_hal_dma_ex.o"
"shortpress_longpress\stm32f4xx_hal_dma.o"
"shortpress_longpress\stm32f4xx_hal_pwr.o"
